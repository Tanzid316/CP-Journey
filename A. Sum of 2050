#include<bits/stdc++.h>
using namespace std;
int main()
{
    int t;
    cin>>t;
    while(t--)
    {
        long long n;
        cin>>n;
        int ans=0;
        while(n>=2050)
        {
            ans++;
            long long x=2050;
            while(x<=n)
            {
                x*=10;
            }
            x/=10;
            n=n-x;
        }
        if(n!=0)cout<<-1<<endl;
        else cout<<ans<<endl;
    }
    return 0;
}
